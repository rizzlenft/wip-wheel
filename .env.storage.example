# Copy this file to .env.storage (gitignored) and fill in your wallet.
# Then run: npm run storage:v1
#
# World: rizzle.dcl.eth — same vars apply to Preview once set on DCL Storage.

# Required for START LIVE / END LIVE (use the wallet you connect with in Explorer)
WIP_HOST_WALLET=0xYOUR_WALLET_HERE

# Recommended (Meetup-friendly auto live; skip if you only host manually)
ROUND_EVERY_SEC=900
LIVE_ROUND_MAX_SEC=600

# Public treasury address (already documented in design/SHIP.md)
PRIZE_TREASURY=0xd9618C06458e98a831F503194cC8b62fB0384d45

# Optional — only if not already set on World (NEVER commit real keys)
# FULFILLER_PRIVATE_KEY=0x...
