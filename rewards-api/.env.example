# Copy to .env and fill in. Never commit .env.

# public URL the scene will call (set the same in src/rewardsConfig.ts when enabling)
PORT=8787

# When true, skip ADR-44 crypto verify and trust X-Dev-Wallet (local preview only).
# MUST be false in production.
DEV_AUTH_BYPASS=true

# Comma-separated wallets allowed to hit /v1/admin/* (lowercase).
ADMIN_WALLETS=

# Shared secret for admin + fulfillment CLI (Bearer token).
ADMIN_TOKEN=change-me-before-thursday

# Optional: require Origin to look like a DCL client when not in DEV.
# STRICT_ORIGIN=true

# Prize treasury (public deposit address — also in catalog/treasury.json).
PRIZE_TREASURY_ADDRESS=0x351764F8Ef0A80953F80885Fa0f7a7c5F097fC29
