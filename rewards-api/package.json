{
  "name": "wip-wheel-rewards-api",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative daily/show prize API for The WIP Wheel. Scene is untrusted.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "fulfill:list": "tsx src/cli/listPending.ts",
    "fulfill:mark": "tsx src/cli/markFulfilled.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dcl/crypto": "^3.4.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "tsx": "^4.19.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
