# Local Multiplayer Server secrets (preview only). Never commit.
# Production: set via:
#   npx sdk-commands storage env set FULFILLER_PRIVATE_KEY --value 0x...
#   npx sdk-commands storage env set PRIZE_TREASURY --value 0xd9618C06458e98a831F503194cC8b62fB0384d45
#
# Must match the operating hot wallet (see fulfill-worker/data/HOT_WALLET.txt).
# FULFILLER_PRIVATE_KEY=0x...
# PRIZE_TREASURY=0xd9618C06458e98a831F503194cC8b62fB0384d45
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Seconds between live-round slots. Default 7200 (2 hours). Min 60, max 86400.
# ROUND_EVERY_SEC=900
# Max seconds for one live round before auto-close. Default 900.
# LIVE_ROUND_MAX_SEC=600
# Comma-separated host wallets (START LIVE / END LIVE). Set via npm run storage:v1 or Hub Storage.
# HOST_WALLETS=0xYourWallet
